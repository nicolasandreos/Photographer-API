# API
APP_PORT=3000
SWAGGER_SERVER_URL=http://localhost:3000

# Prisma migrations and seed (MySQL from docker compose, host port 3310)
DATABASE_URL=mysql://root:root@127.0.0.1:3310/photostudio

# Runtime Prisma / MariaDB adapter
DATABASE_HOST=127.0.0.1
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_PORT=3310
DATABASE_NAME=photostudio
# DATABASE_SSL=true

# Redis (queue + login rate limit)
REDIS_URL=redis://127.0.0.1:6379

# JWT — use strong unique values in any real environment
JWT_SECRET_KEY=change-me-access-token-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-token-secret
JWT_EMAIL_VERIFICATION_SECRET_KEY=change-me-email-verification-secret
JWT_CHANGE_PASSWORD_SECRET_KEY=change-me-change-password-secret

# Email (Resend). Confirmation emails are only sent when the worker is running.
RESEND_API_KEY=re_your_api_key
EMAIL_VERIFICATION_URL=http://localhost:3000/photographer/verify-email
FORM_CHANGE_PASSWORD_URL=http://localhost:3000/photographer/change-password-form

# Login rate limit (defaults: 5 requests / 60 seconds)
REQUEST_RATE_LIMIT_MAX=5
REQUEST_RATE_LIMIT_WINDOW_SECONDS=60

# Azure Blob Storage (profile pictures)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=photographer-profile-picture
AZURE_STORAGE_PUBLIC_BASE_URL=https://youraccount.blob.core.windows.net/photographer-profile-picture
